// Kopieren nach Secrets.xcconfig (gitignored) und mit den Werten deines
// Supabase-Projekts befüllen (Projekteinstellungen -> API) - dieselben
// Werte wie in wizard/frontend/.env.example. Werden über project.yml in
// die generierte Info.plist durchgereicht und dort zur Laufzeit von
// SupabaseService.swift gelesen.

SUPABASE_URL = https:/$()/xxxxxxxx.supabase.co
SUPABASE_ANON_KEY = your-anon-key-here

// Das "$()" zwischen den beiden Schrägstrichen oben ist kein Tippfehler:
// xcconfig-Dateien behandeln "//" als Kommentarbeginn, auch innerhalb eines
// Werts - ohne das leere Macro würde alles ab "https://" verschluckt. Beim
// Einsetzen der echten URL dieselbe Schreibweise beibehalten.

